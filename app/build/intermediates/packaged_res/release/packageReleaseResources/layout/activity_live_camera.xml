<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/topCameraBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnBackCamera"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCameraChildName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rahul's Phone - Live Camera"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Camera Stream Active"
                android:textColor="@color/accent_pink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Camera Video Frame Stream -->
    <ImageView
        android:id="@+id/ivCameraStream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomCameraControl"
        android:layout_below="@id/topCameraBar"
        android:contentDescription="Live Camera Stream"
        android:scaleType="fitCenter" />

    <!-- Loading Placeholder -->
    <LinearLayout
        android:id="@+id/loadingCameraPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connecting Live Camera Stream..."
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom Controls (Camera Switcher) -->
    <LinearLayout
        android:id="@+id/bottomCameraControl"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/card_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSwitchFront"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:text="🤳 Front Camera"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnSwitchBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary_sky"
            android:text="📷 Rear Camera"
            android:textColor="@color/text_white" />
    </LinearLayout>

</RelativeLayout>
